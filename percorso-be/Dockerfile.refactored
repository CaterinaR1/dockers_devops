
# Stage 1: builder
FROM node:20.11.1-alpine3.19 AS builder

WORKDIR /app

# 1. Dipendenze prima del sorgente: cache più efficiente
COPY package*.json ./
RUN npm ci

# 2. Copia il codice sorgente
COPY src/ ./src/

# 3. Rimuove le dipendenze di sviluppo
RUN npm prune --omit=dev

# Stage 2: runtime
FROM node:20.11.1-alpine3.19 AS runtime

WORKDIR /app

ENV NODE_ENV=production

# Copia solo ciò che serve per eseguire l'app
COPY --from=builder --chown=node:node /app/package.json ./package.json
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/src ./src

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --spider -q http://localhost:3000/healthz || exit 1

# Formato exec: Node riceve direttamente SIGTERM
CMD ["node", "src/index.js"]
